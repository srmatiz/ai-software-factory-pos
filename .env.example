# Copy to .env for local development: cp .env.example .env
# In production, set these in your hosting provider's environment/secrets UI.

# PostgreSQL connection string (local value matches docker-compose.yml)
DATABASE_URL="postgresql://pos:pos_local_dev@localhost:5433/pos?schema=public"

# Auth.js secret. Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-random-32-byte-secret"

# Required by Auth.js when not running on Vercel
AUTH_TRUST_HOST="true"
